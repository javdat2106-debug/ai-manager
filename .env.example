# Gemini — ключ хранится только на сервере (без префикса NEXT_PUBLIC_)
GEMINI_API_KEY=
# Необязательно: конкретная модель. Если пусто — перебираются gemini-3.8-flash, gemini-3.6-flash, gemini-3.5-flash
GEMINI_MODEL=

# Turso (libSQL). Для локальной разработки можно file:local.db
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=
